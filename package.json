{
  "name": "legal-os-monorepo-root",
  "version": "1.0.0",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "build": "npm --prefix backend install",
    "start": "npm --prefix backend start",
    "desktop:dev": "concurrently \"cross-env ELECTRON_APP=true NODE_ENV=development npm run dev --prefix backend\" \"wait-on tcp:3001 && cross-env ELECTRON_APP=true NODE_ENV=development electron electron/main.js\"",
    "desktop:build-frontend": "npm run build --prefix dashboard",
    "desktop:build": "npm run desktop:build-frontend && electron-builder --windows"
  },
  "build": {
    "appId": "com.samogola.legalos",
    "productName": "Legal OS",
    "copyright": "Copyright © 2026 Sam Ogola & Co. Advocates",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "backend/**/*",
      "dashboard/dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "electron/assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "node-fetch": "^2.7.0",
    "pg": "^8.22.0",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "cross-env": "^7.0.3",
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.0.10"
  }
}
